# Server-only secrets. Never prefix these names with NEXT_PUBLIC_.
# Gemini is called only from the server route.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LUNG_CANCER_LIBRARY_DETAILED_DIAGNOSIS_API_KEY=
LUNG_CANCER_LIBRARY_IMMUNOPATHOLOGY_BY_TYPE_API_KEY=
LUNG_CANCER_LIBRARY_SURGICAL_PATHOLOGY_PATHOLOGIC_STAGE_API_KEY=
LUNG_CANCER_LIBRARY_BRONCHOSCOPY_BY_TYPE_API_KEY=

# Local development defaults to the deterministic demo. Set false only for a controlled Gemini test.
PATHOSCRIBE_DEMO_MODE=true

# Vercel automatically sets VERCEL=1. Set this only for a non-Vercel public deployment.
PATHOSCRIBE_PUBLIC_DEPLOYMENT=false

# Required for public live Gemini analysis. Use a durable Upstash Redis REST database, not in-memory state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PATHOSCRIBE_RATE_LIMIT_SALT=
PATHOSCRIBE_RATE_LIMIT_REQUESTS=12
PATHOSCRIBE_RATE_LIMIT_WINDOW_SECONDS=3600
