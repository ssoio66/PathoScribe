{
  "name": "pathoscribe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-cancer-dictionary-snapshot.mjs --fetch-official",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/validate-pathology-workflow.mjs",
    "test:v1.1": "node scripts/validate-v1.1-unit.mjs",
    "test:normal-cases": "node scripts/validate-normal-demo-cases.mjs",
    "test:error-cases": "node scripts/validate-error-demo-cases.mjs",
    "test:case-audit": "node scripts/audit-evaluation-cases.mjs",
    "test:worklist-links": "node scripts/validate-worklist-evaluation-links.mjs",
    "test:web": "node scripts/verify-web-routes.mjs",
    "data:sync:diagnoses": "node scripts/sync-ncc-diagnosis-reference.mjs",
    "data:sync:immunopathology": "node scripts/sync-ncc-immunopathology.mjs",
    "data:sync:pathologic-stages": "node scripts/sync-ncc-pathologic-stages.mjs",
    "data:sync:bronchoscopy": "node scripts/sync-ncc-bronchoscopy.mjs",
    "data:sync:cancer-dictionary": "node scripts/sync-cancer-dictionary-snapshot.mjs",
    "data:sync:lung-linkage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-ncc-lung-linkage.ps1",
    "data:sync:registry-metadata": "node scripts/sync-ncc-lung-registry-metadata.mjs",
    "data:generate:pathology-workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-pathology-workflow.ps1",
    "data:generate:outsourced-fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-outsourced-evaluation-fixtures.ps1",
