  "dependencies": {
    "@google/genai": "^2.13.0",
    "html-to-text": "^10.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
