    "data:test:evaluation": "node scripts/validate-evaluation-cases.mjs",
    "data:test:pathology-workflow": "node scripts/validate-pathology-workflow.mjs",
    "evaluate:gemini": "node scripts/run-gemini-evaluation.mjs",
    "test:evaluation-runner": "node scripts/validate-gemini-evaluation.mjs"
